# Copy to .env. The Go binary and the Makefile read these from the environment.
DATABASE_URL=postgres://ground:ground@127.0.0.1:5433/ground?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Optional: an empty database for tests that need Postgres (see `make test-db`).
# Every table in it is emptied by the tests.
TEST_DATABASE_URL=postgres://ground:ground@127.0.0.1:5433/ground_test?sslmode=disable

# Admin endpoints are disabled when this is empty.
ADMIN_TOKEN=

# Without a key crawling continues, but AI dispatch is paused.
ALLOW_FAKE_AI=false
# Any OpenAI-compatible chat-completions endpoint works; leave OPENAI_BASE_URL
# empty for api.openai.com, or point it at a proxy such as LiteLLM.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Must support strict JSON-schema structured output.
OPENAI_SUMMARY_MODEL=

# Sent to outlets and matched against their robots.txt. Add a contact URL or
# address before crawling for real, e.g. "GroundNewsTW-bot/0.1 (+https://example.org/bot)".
CRAWLER_USER_AGENT=GroundNewsTW-bot/0.1
# Newly admitted articles per Taiwan calendar day (not API calls or dollars).
AI_MAX_NEW_ARTICLES_PER_DAY=500

# Used by the web app's server-side loaders.
API_URL=http://127.0.0.1:8080
